# Monorepo root .gitignore for SIM Kos & Guesthouse

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE and Editors
.idea/
.vscode/
*.swp
*.swo
*~

# Backend (Laravel)
backend/vendor/
backend/node_modules/
backend/public/storage
backend/public/hot
backend/public/build
backend/storage/*.key
backend/storage/pail
backend/storage/framework/cache/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/storage/logs/*.log
backend/.env
backend/.env.backup
backend/.env.production
backend/.phpunit.result.cache
backend/.phpunit.cache
backend/database/database.sqlite
backend/database/database.sqlite-journal

# Mobile (Flutter)
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.pub-cache/
mobile/.pub/
mobile/build/
mobile/android/app/debug
mobile/android/app/profile
mobile/android/app/release
mobile/**/*.iml
mobile/ios/Flutter/.last_build_id

# Logs
*.log
